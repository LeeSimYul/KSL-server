# ─────────────────────────────────────────────────────────────
#  VRChat 한국수어교실 · send_welcome_embed.py 환경 변수 샘플
#  이 파일을 .env 로 복사한 뒤 값을 채워 쓰세요.  (cp .env.example .env)
#  ⚠️ .env 는 .gitignore 에 들어 있습니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# [필수] #안내 채널 웹후크 주소
#   디스코드 #안내 채널 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → 웹후크 URL 복사
#   이 주소만 있으면 누구나 채널에 글을 쓸 수 있으니 비밀번호처럼 다뤄 주세요.
DISCORD_WEBHOOK_URL=

# [선택] 아래 값은 비워 두거나 줄을 지우면 send_welcome_embed.py 안의 기본값(같은 값)을 씁니다.
#   채널 ID: 디스코드 설정 → 고급 → 개발자 모드 켜기 → 채널 우클릭 → 'ID 복사'

# 📋┃규칙 채널 ID - 본문 '📜 상세 규칙 (Full Rules)' 칸의 채널 멘션
RULES_CHANNEL_ID=1414463866863226983

# VRChat 그룹 공유 링크 - '바로가기 모음' 칸의 그룹 링크
VRCHAT_GROUP_URL=https://vrc.group/KSL.8324

# 📑┃안내 채널 ID - 기록용. 현재 Embed 구성에서는 쓰지 않습니다.
GUIDE_CHANNEL_ID=1105140914839625750
